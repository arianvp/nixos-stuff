+/// Finds the signature database entry with a certificate from the image's signatures.
+fn image_certificate<'a, 'b, Image>(
+    image: &'a Image,
+    efi_signature_data: &[&'b esl::EfiSignatureData],
+) -> anyhow::Result<Option<&'b esl::EfiSignatureData>>
+where
+    Image: authenticode::PeTrait,
+{
+    // Look for a matching image signature
+    authenticode::AttributeCertificateIterator::new(image)?
+        .into_iter()
+        .flatten()
+        .map(|attribute_certificate| {
+            // Walk the certificate chain
+            Ok::<_, anyhow::Error>(
+                attribute_certificate?
+                    .get_authenticode_signature()?
+                    .certificates()
+                    .map(x509_cert::der::Encode::to_der)
+                    .find_map(|certificate| {
+                        // Look up the certificate in the signature database. This does not
+                        // validate the signature or apply the signature denylist; Secure Boot
+                        // does both.
+                        certificate
+                            .map(|certificate| {
+                                efi_signature_data.iter().copied().find(|efi_signature_data| {
+                                    certificate == efi_signature_data.signature_data
+                                })
+                            })
+                            .transpose()
+                    })
+                    .transpose()?,
+            )
+        })
+        .find_map(Result::transpose)
+        .transpose()
+}
+
 fn separator_hash(algorithm: &'static aws_lc_rs::digest::Algorithm) -> aws_lc_rs::digest::Digest {
     aws_lc_rs::digest::digest(algorithm, &[0u8; 4])
 }
